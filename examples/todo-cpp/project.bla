project TodoCpp

use behavior  "../todo.bla"
use structure "todo-cpp.bla"

verify behavior {
    prepare ["g++", "-std=c++20", "-O1", "-static-libstdc++", "-static-libgcc", "-I", "../../adapters/c", "-o", ".blabla/todo-cpp", "main.cpp", "../../adapters/c/blabla_adapter.c"]
    command [".blabla/todo-cpp"]
    seed 0
    cases 4
    steps 32
    timeout_ms 1000
    shrink_budget 256
}
