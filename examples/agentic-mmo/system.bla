system "simulation" { purpose "Deterministic headless immediate tactical transitions, slower strategic consequences and legal actions; calendar and rendering are separate." paths ["core/"] knowledge ["engineering", "testing", "design"] }
system "agents" { purpose "Versioned structured commands, persistence and truthful procedural or historical replay; no runtime model dependency." paths ["cli/"] knowledge ["engineering", "testing"] }
system "spectator" { purpose "Original civilization map, faithful event playback and inspection without human world controls." paths ["web/", "visuals/"] knowledge ["engineering", "testing", "design"] }
system "verification" { purpose "Executable contracts, focused checks and deployment artifacts." paths ["contracts/", "tests/", "scripts/"] knowledge ["testing", "reviewing"] }
responsibility "bounded-headless-work" { owner "simulation" statement "Measure finite representative action, observation, clock-catchup and history workloads with source and environment recorded. Assert deterministic state/event/action bounds and faithful outcomes. No renderer acknowledgement, animation or tight machine-specific wall-clock threshold controls simulation acceptance." }
responsibility "compact-agent-protocol" { owner "agents" statement "Keep legal choices, observations and results compact and measured; validate once through shared domain rules, preserve revision/idempotence receipts and avoid unnecessary duplicated payloads. A bounded run budget is not the world lifetime." }
responsibility "mobile-viewer-budget" { owner "spectator" statement "Keep the map and meaningful inspection usable at actual phone portrait sizes with reachable touch targets, readable labels and non-overlapping sheets. Bound visible history and scene objects, dispose replaced renderers and pause needless hidden-tab work. Measure frame and memory behavior on supported browsers; fallback evidence never proves WebGL or physical touch performance." }
seam "committed-world" { between ["simulation", "spectator"] value "WorldState and GameEvent" statement "The renderer displays committed state and events and never decides outcomes." moves_with ["core/types.ts"] }
seam "structured-turns" { between ["simulation", "agents"] value "Command and Observation" statement "Every actor uses validated versioned commands and compact legal choices; no renderer is needed." moves_with ["core/types.ts"] }

system "authoritative-host" { purpose "Durable revision-protected commits, public reads, enrolled authenticated writes and externally triggered realization of due clock ticks; no undocumented scheduler guarantee." paths ["server/"] knowledge ["engineering", "testing", "reviewing"] }
responsibility "indexed-bounded-persistence" { owner "authoritative-host" statement "Use indexed cursor pages and revision-conditional reads with measured payload, query and row work. Unchanged observations perform no persistent writes. Preserve current state, required history, receipts and replay through explicit tested migration/retention decisions; never silently discard history. Validate actual managed-host limits separately from generic provider tiers." }
seam "durable-transitions" { between ["simulation", "authoritative-host"] value "WorldState and TransitionResult" statement "One pure engine decides transitions; the host commits state, transition and typed receipt atomically with optimistic concurrency. Authentication belongs to the host, not game rules." moves_with ["core/types.ts", "server/repository.ts"] }
seam "public-observation" { between ["authoritative-host", "spectator"] value "Committed state and bounded history pages" statement "Anonymous spectators only read authoritative facts; rendering does not initialize worlds or realize clock ticks, and viewer state never overwrites simulation state." moves_with ["server/worker.ts", "web/main.ts"] }
seam "bounded-world-data" { between ["authoritative-host", "spectator"] value "Measured state, observation and paged history budgets" statement "APIs expose indexed bounded pages and unchanged-revision handling; rendering limits visible objects independently of simulation speed. Baselines state workload, source revision and environment. Persistence optimization preserves exact replay, idempotency and archived history, and actual managed-host quotas must be verified separately." moves_with ["benchmarks/", "server/repository.ts", "web/live-world.ts"] }

responsibility "independent-fair-admission" { owner "authoritative-host" statement "Admit civilization actions independently with bounded per-actor tactical windows, atomic current-state revalidation and durable idempotency. A stale numeric choice never silently selects another action. Shared strategic economy beats do not require all actors to act; explicit timestamped realization and replay preserve actual late-execution evidence. Migrate existing runs through an explicit release without rewriting old frames." }
responsibility "bounded-action-plans" { owner "simulation" statement "Own one shared typed lifecycle and at most two actionable plan items per civilization. Queued intent becomes an actual action only through normal validation and fair admission. Success, failure, blockage or invalidation produces a concrete result and requires reevaluation; old history is not an unbounded active queue." }
responsibility "screen-size-map-detail" { owner "spectator" statement "Derive far, middle and close visual detail from projected screen size. Share meshes, materials and content facts; avoid hidden expensive geometry. Keep selected-city labels and accessible targets while reducing distant label density. Farm, growth and event visuals must represent committed facts, and measured mobile object/frame limits govern implementation." }

responsibility "prepared-capability-pool" { owner "simulation" statement "Validated content supplies useful current discoveries/buildings plus connected prepared successors. Shared operating recipes express inputs and outputs without per-building branches; civilizations can pause input-consuming operations. Release gates keep prepared definitions unavailable until their mechanics are implemented and an authorized compatible release is applied to that world; source/live review identifies real catalogue dead ends before they stall future play." }

system "procedural-controllers" { purpose "Pure seeded weighted finite-state civilization and Director choices over authoritative legal actions, separate from game rules, storage and rendering." paths ["core/behaviors.ts", "core/behavior-profiles.ts", "core/behavior-progression.ts", "core/behavior-diplomacy.ts", "core/behavior-relief.ts"] knowledge ["engineering", "testing", "design"] }
responsibility "reproducible-weighted-decisions" { owner "procedural-controllers" statement "Versioned soft personality weights and world-driven states choose exact eligible actions. Required research/construction/civic lanes receive fair attention; active commitments, release gates and costs remain engine-owned. Stable per-seat memory and random cursors survive restart and advance only with accepted outcomes. Empty admission returns a blocked result, never a fabricated wait." }
seam "durable-procedural-control" { between ["procedural-controllers", "authoritative-host"] value "BehaviorDecision and BehaviorMemory" statement "A protected explicitly activated bounded wake uses real host time and atomically commits exact engine actions, controller memory and receipts. Repeated wakes and competing writers cannot duplicate decisions. Missed time earns economy catchup, not invented retrospective tactical choices. Source support alone never establishes a deployed unattended trigger." moves_with ["core/behaviors.ts", "server/autonomous-runner.ts", "server/public-protocol.ts"] }

responsibility "factual-planetary-views" { owner "spectator" statement "Earth forms derive from each town or site installed assets and paid construction; operational activity requires a current actual operation and stops at terminal state. Earth and Mars are observer-only main-viewport bodies with source, immutable genesis and body-qualified cameras. Mars terrain is illustrative context, never simulated geography or ownership; habitat form, residents and reserve cargo come from actual paid colony records. Transit is not arrival, delivered supplies are not local production, and inspecting a finished world cannot advance it." }

responsibility "qualified-consequential-history" { owner "simulation" statement "New regional Director content admits only actual eligible local geography, production, delivered trade and conserved residents. The same finite eligibility governs tactical and direct Director commands; exact paid effects and causes remain recorded. Additive release flags preserve old event definitions and older procedural policy paths." }


system "regional-locality" {
  purpose "Versioned constrained regional-event target selection and exact immediate mutation receipts."
  paths ["core/historical-selection.ts", "core/historical-selection-validation.ts", "core/simulation/historical-events.ts"]
  knowledge ["engineering", "testing", "design"]
}
responsibility "stable-regional-targets" {
  owner "regional-locality"
  statement "Choose a qualifying town then its attachment from immutable world seed, family, civilization and successful occurrence; never revision, wall time or shared RNG. Persist the exact closed selector through action, plan, CLI, hosted CAS and tick paths. Revalidate that tuple without replacement; retain legacy family odds and release replay. Immediate receipts conserve and explain exact paid effects; historical records are not silently backfilled."
}

responsibility "consented-funded-relief" { owner "simulation" statement "An explicit donor proposal and recipient consent fix a bounded one-way Food amount over an existing exact land corridor. Historical proposal need is not a due-time deficit requirement. Revalidate route, consent and full funding at due resolution; transfer conserved civilization Food and pay the stated Energy once, or record truthful zero-effect termination. Incoming promises are not stock; rejection, environmental shortage and voluntary withdrawal have no invented betrayal penalty." }

responsibility "distinct-local-world-succession" { owner "spectator" statement "A newly activated local ruleset has its own immutable seeded genesis and storage identity. Under browser locking, allocate and persist the zero-step genesis before starting its Worker; concurrent initializers adopt that same saved world. Prior generated and legacy saves remain explicitly selectable read-only, with exact source, body and genesis view identities. Storage failures never overwrite history; terminal observation never advances a finished world. This local simulation is not shared-host activation." }
