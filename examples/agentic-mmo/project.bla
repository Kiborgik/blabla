use structure "contracts/architecture.bla"
use behavior "contracts/campaign.bla"
draft behavior "contracts/future-outcomes.bla"
use behavior "contracts/concurrency.bla"
use behavior "contracts/production.bla"
use behavior "contracts/strategy.bla"
use behavior "contracts/spectator.bla"
use behavior "contracts/frontiers.bla"
use behavior "contracts/recovery.bla"
use behavior "contracts/public-projects.bla"
draft behavior "contracts/trade-endpoints.bla"
draft behavior "contracts/agent-observations.bla"
draft behavior "contracts/action-receipts.bla"
use behavior "contracts/land-transport.bla"
draft behavior "contracts/operating-resource-exchange.bla"
draft behavior "contracts/choice-pages.bla"
draft behavior "contracts/route-map.bla"
