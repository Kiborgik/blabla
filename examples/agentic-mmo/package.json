{
  "name": "agentic-civilizations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 0.0.0.0",
    "build": "vp build",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "vp lint",
    "check": "vp check",
    "format": "vp fmt",
    "test": "node --test tests/*.test.ts",
    "verify:scaffold": "node scripts/verify.ts scaffold",
    "verify": "node scripts/verify.ts all",
    "replay": "node cli/main.ts replay",
    "agent": "node cli/main.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  }
}
