goal "prospective-dogfooding" { serves ["honest-incremental-delivery"] statement "Use real task acceptance, exact evidence, independent reviews and canonical finish before claiming an increment complete; preserve an inspectable account of development-agent play and friction." expect ["contract::bootstrap"] state "active" }
goal "history-to-mars" { serves ["full-historical-arc"] statement "A persistent development-linked world starts in settlement and grows toward Mars as actual shipped features and observable in-world events permit calendar milestones. Future capabilities stay planned until implemented. The authoritative six-minute clock adds ten years, with a hundred-year milestone every ten ticks; routine event/review injections add no years. Explicit deliberate feature or Director-event advances may add history once with a visible cause and receipt, independent of baseline clock accounting. Ordinary turn count alone does not move history." expect ["campaign::five-civilizations", "campaign::bounded-era", "future-outcomes::colonies-need-spaceflight"] state "active" }
goal "interconnected-world" { serves ["one-world-many-strategies"] statement "Production, supply routes, research, population, culture and political agreements produce observable cross-system consequences." expect ["campaign::route-integrity", "campaign::nonnegative-population"] state "active" }
goal "six-clear-fast-agents" { serves ["fast-agents-readable-spectacle"] statement "Five civilizations and an AI World Director use compact legal observations and validated structured commands without waiting for visual playback." expect ["campaign::six-actor-turn-order", "campaign::accepted-command-advances-once", "campaign::refused-command-preserves-revision"] state "active" }
goal "scientific-and-political-endings" { serves ["one-world-many-strategies", "full-historical-arc"] statement "Future implemented milestones can support a viable Mars settlement and a functioning federation, each with visible progress and counterplay. These endings remain planned while the current-age world grows with development. Owner review decides strategic quality." expect ["future-outcomes::colonies-need-spaceflight", "future-outcomes::outcome-is-final"] state "active" }
goal "cultural-victory" { serves ["one-world-many-strategies"] statement "A later increment supports a voluntarily adopted cultural network rooted in attractive functioning cities, with contestable influence and meaningful counterplay." expect ["victories::cultural-network-is-an-ending"] state "active" }
goal "economic-victory" { serves ["one-world-many-strategies"] statement "A later increment supports sustained pivotal resilient trade across independent partners, with substitution and renegotiation counterplay." expect ["victories::resilient-trade-is-an-ending"] state "active" }
goal "military-victory" { serves ["one-world-many-strategies"] statement "A later increment supports supplied political hegemony with occupation, reconstruction and legitimacy costs, not merely territory counting." expect ["victories::supplied-hegemony-is-an-ending"] state "active" }
goal "watchable-spectator" { serves ["fast-agents-readable-spectacle"] statement "An original CIV-like map shows changing cities, borders, routes and motion. Camera, playback and inspection are the only human controls; viewers can identify causes and consequences. Owner reviews actual appearance and clarity." expect ["spectator::no-world-command-controls", "spectator::events-drive-playback"] state "active" }
goal "durable-faithful-replay" { serves ["honest-incremental-delivery"] statement "Versioned seeded commands reproduce committed outcomes, restart preserves state, and recordings identify built-in-policy versus actual development-agent sources." expect ["campaign::restart-preserves-world", "bootstrap::replay-identifies-its-source"] state "active" }
goal "public-updated-presentation" { serves ["honest-incremental-delivery"] statement "Each integrated feature is available at a public no-auth spectator link with an accurate change presentation; deployed version changes auto-reload without loops, preserving compatible observational preferences." expect ["spectator::version-update-reloads-once"] state "active" }
goal "authoritative-live-world" { serves ["honest-incremental-delivery"] statement "Immediately after the public scaffold, ship durable authoritative live turns and protected agent writes while spectators remain public read-only. Preserve run history across victory/collapse restarts. Hosting details must be verified rather than assumed." expect ["hosting::concurrent-commands-commit-once"] state "active" }

goal "development-moves-history" { serves ["full-historical-arc", "honest-incremental-delivery"] statement "Every calendar transition comes from either a durable six-minute clock tick adding ten years or a separately authorized deliberate feature/Director-event advance with a typed cause, stable identifier, visible reason and durable receipt. Intentional jumps never rebase or double-count clock intervals. Each ten clock ticks marks a hundred-year milestone. Ten-minute events and hourly review inject events without double-counting years; ordinary turns do not move calendar, and unimplemented future mechanics never block or silently unlock from time alone." expect ["campaign::turns-do-not-advance-calendar", "architecture::content-owns-feature-availability"] state "active" }

goal "ship-play-advance" { serves ["ship-play-advance", "honest-incremental-delivery"] statement "A working stage is shipped and actually played, then the Creative Director selects the next meaningful mechanic or historical milestone. Fun and balance are learned through live play; no indefinite polish or exhaustive campaign gate blocks roadmap progress." expect ["campaign::accepted-command-advances-once", "architecture::content-owns-feature-availability"] state "active" }
goal "dry-solid-data-driven" { serves ["dry", "solid", "data-driven"] statement "Enforce DRY, SOLID and DATA DRIVEN through falsifiable source boundaries, behavior scenarios proving shared rules and an independent semantic review. Shared catalogues feed legal choices and displays; the pure engine owns decisions; adapters and viewers cannot duplicate or override them. Structural GREEN is evidence for named facts, not proof of all three design principles." expect ["spectator-preview::renderer-uses-content", "spectator-preview::inspection-uses-the-same-content", "spectator-preview::viewer-delegates-rendering", "bootstrap::shared-command-schema", "architecture::content-owns-feature-availability", "architecture::command-effects-share-one-interpreter"] state "active" }

goal "tactical-and-strategic-systems" { serves ["tactics-and-strategy", "one-world-many-strategies"] statement "Immediate actions change concrete world facts while longer-lived programs, agreements and projects create slower strategic consequences across economic, scientific, political, cultural and military systems. The next trade increment demonstrates an immediate offer and a lasting consensual exchange with later shipments. Neither actions nor strategic state depend on rendering or the six-minute calendar." expect ["strategy::immediate-order-affects-persistent-commitment"] state "active" }
goal "spectator-comfort-and-history" { serves ["fast-agents-readable-spectacle"] statement "Desktop and mobile viewing keep the map primary, offer touch-accessible inspection, readable simple English, distinct symbols and color, light/dark/system theme and adjustable effects. A clickable BlaBla footer sits beside version and a changelog with older releases collapsed. Live history has bounded cursor pages, stable inspection scroll and a new-events notice; virtualization is added only for genuinely large expanded views with accessible fallback." expect ["spectator::accessible-preferences", "hosting::bounded-history-pages"] state "active" }
goal "compatible-expansion-and-archived-runs" { serves ["ship-play-advance", "honest-incremental-delivery"] statement "A compatible delivered expansion enters the existing inhabited world through an explicit revision-protected, idempotent release operation, preserving history. Victory, all-collapse or an explicitly incompatible expansion may archive a run and start a named new run with current capabilities. Browser reload, process recovery, release application and archived restart are distinct operations; the latter two remain planned until their actual checks and public evidence exist." expect ["lifecycle::release-applies-once", "lifecycle::archived-run-remains-readable"] state "active" }
