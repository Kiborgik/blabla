role "orchestrator" { purpose "Own intent, shared interfaces, task decomposition, integration, commits and completion." owns ["project.bla", "contracts", "shared types", "integration", "commits", "finish"] verification "product" model ["gpt-6-astra"] consult ["engineering", "testing", "design"] }
role "worker" { purpose "Implement a bounded assigned change and focused tests." owns ["assigned disjoint scope", "focused checks"] verification "focused" block_below "70" model ["gpt-6.1-sol", "gpt-6-astra"] consult ["engineering", "testing"] }
role "reviewer" { purpose "Independently falsify a bounded patch against its actual task and code." owns ["evidenced findings"] verification "focused" model ["gpt-6-astra"] consult ["reviewing", "testing", "design"] }
policy "shared-branch-disjoint-writes" { statement "All agents share one branch. Accept before edits. Write only assigned paths. The orchestrator owns git mutations and shared files. Workers never spawn agents or run project-wide gates." applies_to ["orchestrator", "worker", "reviewer"] }
policy "honest-evidence" { statement "Read actual child exits and complete logs; evidence-command exit zero only means storage succeeded. Record blockers and findings. Never fabricate play, checks, reviews or outcomes." applies_to ["orchestrator", "worker", "reviewer"] }
policy "contracts-before-implementation" { statement "Only the orchestrator authors or explicitly assigns contracts. Future rules remain draft until their work opens; contracts are never weakened to pass." applies_to ["orchestrator", "worker"] }
policy "code-speaks-for-itself" { statement "Code carries no comments or docstrings; names, functions and tests express its meaning. Human text is plain and specific." applies_to ["orchestrator", "worker", "reviewer"] }
flow "development" { purpose "Prospective bounded work, genuine evidence, independent review and canonical completion." }
step "assign" { flow "development" role ["orchestrator"] statement "Open scoped tasks linked to goals before implementation." command "blabla task open" }
step "accept" { flow "development" role ["worker", "orchestrator", "reviewer"] statement "Accept with the actual model and challenge before edits." command "blabla task accept" }
step "implement" { flow "development" role ["worker", "orchestrator"] statement "Implement only the assignment, adding focused tests and playing through the real protocol when available." }
step "verify" { flow "development" role ["worker", "orchestrator", "reviewer"] statement "Run the exact declared check, read full results, assess lenses and challenge before ready." command "blabla task evidence" }
step "review" { flow "development" role ["reviewer"] statement "Read the task, whole diff and deciding code; ground findings in facts." }
step "integrate" { flow "development" role ["orchestrator"] statement "Resolve findings, confirm records, obtain current GREEN and close accepted work; publish each verified feature increment." command "blabla finish" }
