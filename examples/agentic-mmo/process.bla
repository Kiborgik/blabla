role "orchestrator" { purpose "Own intent, shared interfaces, task decomposition, integration, commits and completion." owns ["project.bla", "contracts", "shared types", "integration", "commits", "finish"] verification "product" model ["gpt-6-astra"] consult ["engineering", "testing", "design"] }
role "worker" { purpose "Implement bounded simulation, backend or tooling changes and focused tests; art, visuals and user interfaces belong to the Astra-only visual role." owns ["assigned disjoint scope", "focused checks"] verification "focused" block_below "70" model ["gpt-6.1-sol", "gpt-6-astra"] consult ["engineering", "testing"] }
role "reviewer" { purpose "Independently falsify a bounded patch against its actual task and code; visual and UI review uses Astra only." owns ["evidenced findings"] verification "focused" model ["gpt-6-astra", "gpt-6.1-sol"] consult ["reviewing", "testing", "design"] }
role "creative-director" { purpose "Keep the evolving world coherent, review actual project intent hourly, direct scheduled events and maintain a rolling twelve-hour feature queue." owns ["creative proposals", "reference-led spectator direction", "event recommendations", "adaptive roadmap"] verification "focused" model ["gpt-6-astra"] consult ["design", "reviewing"] }
role "visual-implementer" { purpose "Implement spectator interfaces, original art and visual effects with actual Astra models only." owns ["assigned spectator UI and visual scope", "focused checks and visual evidence"] verification "focused" model ["gpt-6-astra"] consult ["engineering", "testing", "design"] }
policy "shared-branch-disjoint-writes" { statement "All agents share one branch. Accept before edits. Write only assigned paths. The orchestrator owns git mutations and shared files. Workers never spawn agents or run project-wide gates." applies_to ["orchestrator", "worker", "reviewer", "creative-director", "visual-implementer", "art-director", "server-owner"] }
policy "honest-evidence" { statement "Read actual child exits and complete logs; evidence-command exit zero only means storage succeeded. Record blockers and findings. Never fabricate play, checks, reviews or outcomes." applies_to ["orchestrator", "worker", "reviewer", "creative-director", "visual-implementer", "art-director", "server-owner"] }
policy "contracts-before-implementation" { statement "Only the orchestrator authors or explicitly assigns contracts. Future rules remain draft until their work opens; contracts are never weakened to pass." applies_to ["orchestrator", "worker", "creative-director", "visual-implementer", "art-director", "server-owner"] }
policy "code-speaks-for-itself" { statement "Code carries no comments or docstrings; names, functions and tests express its meaning. Human text is plain and specific." applies_to ["orchestrator", "worker", "reviewer", "creative-director", "visual-implementer", "art-director", "server-owner"] }
flow "development" { purpose "Prospective bounded work, genuine evidence, independent review and canonical completion." }
step "assign" { flow "development" role ["orchestrator"] statement "Open scoped tasks linked to goals before implementation." command "blabla task open" }
step "accept" { flow "development" role ["worker", "orchestrator", "reviewer", "creative-director", "visual-implementer", "art-director", "server-owner"] statement "Accept with the actual model and challenge before edits." command "blabla task accept" }
step "research" { flow "development" role ["worker", "orchestrator", "creative-director", "visual-implementer", "art-director", "server-owner"] statement "Before implementing each feature, inspect the relevant existing systems and applicable primary references or prior verified research. Record sources, findings, the chosen approach and remaining uncertainty in the task. Research is proportional: reuse still-current applicable findings rather than repeat unrelated searches for a small repair." command "blabla task note" }
step "implement" { flow "development" role ["worker", "orchestrator", "creative-director", "visual-implementer", "art-director", "server-owner"] statement "Implement only the assignment, adding focused tests and playing through the real protocol when available." }
step "verify" { flow "development" role ["worker", "orchestrator", "reviewer", "creative-director", "visual-implementer", "art-director", "server-owner"] statement "Run the exact declared check, read full results, assess lenses and challenge before ready." command "blabla task evidence" }
step "review" { flow "development" role ["reviewer"] statement "Read the task, whole diff and deciding code; ground findings in facts." }
step "integrate" { flow "development" role ["orchestrator"] statement "Resolve findings, confirm records, obtain current GREEN and close accepted work; publish each verified feature increment." command "blabla finish" }
flow "hourly-intent-review" { purpose "An external hourly review opens a real task whose inputs include mission, goals, systems and process; this declaration does not schedule or launch agents." }
step "inspect-intent" { flow "hourly-intent-review" role ["creative-director"] statement "Read current status, explain the relevant intent and inspect the actual .bla files against the live world, owner direction and next twelve hours of development." command "blabla status" }
step "propose-intent-changes" { flow "hourly-intent-review" role ["creative-director"] statement "Record dated concrete proposals, findings or questions with evidence, assess the design lens and hand the bounded review back without changing requirements to match a failing implementation." command "blabla task ready" }
step "decide-intent-changes" { flow "hourly-intent-review" role ["orchestrator"] statement "Accept or reject each proposal explicitly; scope approved intent edits as a separate task, preserve historical decisions and verify the updated project. Fun and balance observations inform the next feature rather than block launch." command "blabla task open" }

policy "astra-only-visual-work" { statement "Every new art, visual or UI implementation task uses art-director or visual-implementer with actual gpt-6-astra. Sol workers own simulation, backend and tooling. Existing pre-policy work is retained without unnecessary rewrites." applies_to ["orchestrator", "worker", "creative-director", "visual-implementer", "art-director", "server-owner"] }
flow "director-event" { purpose "Each scheduled event follows current world facts and Creative Director advice." }
step "read-and-consult" { flow "director-event" role ["orchestrator", "creative-director"] statement "Read the authoritative snapshot, agree a supported event and target with a concrete purpose, then submit once with a durable interval receipt. Record the accepted transition; an unavailable runtime means no event occurred. Routine events do not move years unless a separate deliberate hybrid advance is authorized and explained." }
policy "affected-intent-disposition" { statement "New feature and intent tasks opt into --require-intent-disposition. Before hand-back, inspect each affected mission, goal, system, process and knowledge identity and record a current updated or confirmed-unchanged reason with task disposition. Changed source or intent invalidates relevant receipts; independent review assesses their meaning. Legacy tasks retain their original obligations. Receipts enforce accountability, not semantic truth or goal acceptance." applies_to ["orchestrator", "reviewer", "creative-director", "worker", "visual-implementer", "art-director", "server-owner"] }
policy "research-before-features" { statement "Every feature has recorded proportional research and a chosen approach before implementation. Prefer actual current source, verified primary references and reusable prior findings. Research does not authorize new scope and must not become an indefinite gate that replaces delivery." applies_to ["orchestrator", "worker", "creative-director", "visual-implementer", "art-director", "server-owner"] }
policy "productive-role-lookahead" { statement "The Creative Director maintains a prioritized, dependency-aware queue extending at least twelve hours ahead. Roles serve their primary responsibilities; when no immediate role work remains, the orchestrator assigns a small ready goal-relevant feature with disjoint ownership. UI and art remain Astra-only, and nobody independently reviews their own patch. The orchestrator starts or resumes the assigned agent, verifies its actual running state and concrete successor outcome; a message to a completed worker alone is not a running assignment. Do not invent redundant reviews or busywork to fill capacity. Real development agents take a bounded supported world turn at handoffs or short work breaks without blocking coding on long playtests." applies_to ["orchestrator", "worker", "reviewer", "creative-director", "visual-implementer", "art-director", "server-owner"] }
policy "cohesive-intent-growth" { statement "A feature task decides whether to extend an existing cohesive contract or register a new system-scoped .bla file, linking it to its goals and affected systems. Inspect registration, missing references, orphan files and duplicated rules using actual available tools and source review. Unregistered files are not authority; mechanical inventories cannot prove semantic consistency. Reuse BlaBla identities, fingerprints and disposition receipts rather than creating a parallel review ledger." applies_to ["orchestrator", "worker", "reviewer", "creative-director", "visual-implementer", "art-director", "server-owner"] }

role "art-director" { purpose "Own only original art, visual language, spectator UI/CSS, effects, animation and reusable asset direction, distinct from gameplay and systems design." owns ["assigned art and spectator presentation", "reusable geometry materials and visual budgets", "actual desktop and mobile visual evidence"] verification "focused" model ["gpt-6-astra"] consult ["engineering", "testing", "design"] }
flow "observer-friction-review" { purpose "An external hourly observer check asks the orchestrator about actual workflow friction and corrective actions; this declaration is not a scheduler and never advances world time." }
step "inspect-friction" { flow "observer-friction-review" role ["orchestrator"] statement "Provide concrete blocker, misuse or tool-defect evidence and the bounded remedy. Distinguish product changes from environmental limits, preserve actual checks and keep the next feature moving." }

role "server-owner" { purpose "Own authoritative server and multiplayer correctness, synchronization, persistence, access control, migrations and durable clock realization using actual Astra." owns ["assigned server and multiplayer scope", "database and protocol integrity", "bounded read and write performance"] verification "focused" model ["gpt-6-astra"] consult ["engineering", "testing"] }
policy "astra-server-ownership" { statement "New authoritative server and multiplayer implementation uses the Astra server-owner role. Preserve pre-policy Sol work with its true authorship and evidence. On replacement, explicitly transfer the active civilization seat and current accepted revision so actual agent play continues." applies_to ["orchestrator", "worker", "server-owner"] }

policy "clear-spectator-language" { statement "Review spectator copy for non-native English readers: familiar words, short direct sentences, no idioms or unnecessary jargon, consistent game terms with keyboard and tap explanations, and visible important numbers and changes. Preserve concrete mechanics and causes; do not replace facts with vague decorative prose. Semantic icons, color and emphasis reinforce text rather than replace meaning." applies_to ["orchestrator", "creative-director", "art-director", "visual-implementer", "reviewer"] }
