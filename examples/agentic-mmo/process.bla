role "orchestrator" { purpose "Own intent, shared interfaces, task decomposition, integration, commits and completion." owns ["project.bla", "contracts", "shared types", "integration", "commits", "finish"] verification "product" model ["gpt-6-astra"] consult ["engineering", "testing", "design"] }
role "worker" { purpose "Implement bounded simulation or tooling changes and focused tests; art, visuals and user interfaces belong to the Astra-only visual role." owns ["assigned disjoint scope", "focused checks"] verification "focused" block_below "70" model ["gpt-6.1-sol", "gpt-6-astra"] consult ["engineering", "testing"] }
role "reviewer" { purpose "Independently falsify a bounded patch against its actual task and code; visual and UI review uses Astra only." owns ["evidenced findings"] verification "focused" model ["gpt-6-astra", "gpt-6.1-sol"] consult ["reviewing", "testing", "design"] }
role "creative-director" { purpose "Keep the evolving world coherent, review actual project intent hourly, direct scheduled events and maintain a rolling twelve-hour feature queue." owns ["creative proposals", "reference-led spectator direction", "event recommendations", "adaptive roadmap"] verification "focused" model ["gpt-6-astra"] consult ["design", "reviewing"] }
role "visual-implementer" { purpose "Implement spectator interfaces, original art and visual effects with actual Astra models only." owns ["assigned spectator UI and visual scope", "focused checks and visual evidence"] verification "focused" model ["gpt-6-astra"] consult ["engineering", "testing", "design"] }
policy "shared-branch-disjoint-writes" { statement "All agents share one branch. Accept before edits. Write only assigned paths. The orchestrator owns git mutations and shared files. Workers never spawn agents or run project-wide gates." applies_to ["orchestrator", "worker", "reviewer", "creative-director", "visual-implementer", "art-director", "server-owner"] }
policy "honest-evidence" { statement "Read actual child exits and complete logs; evidence-command exit zero only means storage succeeded. Record blockers and findings. Never fabricate play, checks, reviews or outcomes." applies_to ["orchestrator", "worker", "reviewer", "creative-director", "visual-implementer", "art-director", "server-owner"] }
policy "contracts-before-implementation" { statement "Only the orchestrator authors or explicitly assigns contracts. Future rules remain draft until their work opens; contracts are never weakened to pass." applies_to ["orchestrator", "worker", "creative-director", "visual-implementer", "art-director", "server-owner"] }
policy "code-speaks-for-itself" { statement "Code carries no comments or docstrings; names, functions and tests express its meaning. Human text is plain and specific." applies_to ["orchestrator", "worker", "reviewer", "creative-director", "visual-implementer", "art-director", "server-owner"] }
flow "development" { purpose "Prospective bounded work, genuine evidence, independent review and canonical completion." }
step "assign" { flow "development" role ["orchestrator"] statement "Open scoped tasks linked to goals before implementation." command "blabla task open" }
step "accept" { flow "development" role ["worker", "orchestrator", "reviewer", "creative-director", "visual-implementer", "art-director", "server-owner"] statement "Accept with the actual model and challenge before edits." command "blabla task accept" }
step "research" { flow "development" role ["worker", "orchestrator", "creative-director", "visual-implementer", "art-director", "server-owner"] statement "Before implementing each feature, inspect the relevant existing systems and applicable primary references or prior verified research. Record sources, findings, the chosen approach and remaining uncertainty in the task. Research is proportional: reuse still-current applicable findings rather than repeat unrelated searches for a small repair." command "blabla task note" }
step "implement" { flow "development" role ["worker", "orchestrator", "creative-director", "visual-implementer", "art-director", "server-owner"] statement "Implement only the assignment, adding focused tests and playing through the real protocol when available." }
step "verify" { flow "development" role ["worker", "orchestrator", "reviewer", "creative-director", "visual-implementer", "art-director", "server-owner"] statement "At completion of a cohesive meaningful feature, run the exact declared check once against the integrated slice, inspect the full child result, assess lenses and challenge before ready. Do not rerun tests, review or full gates after each small edit; make a targeted rerun only when it resolves a concrete failure or changed acceptance evidence." command "blabla task evidence" }
step "review" { flow "development" role ["reviewer"] statement "At a meaningful feature boundary a separate reviewer reads the accepted task, whole diff, deciding code and actual evidence, then records grounded findings. Small edits within that feature do not each trigger a new review. A focused falsification check answers a concrete concern; review volume is not proof." }
step "integrate" { flow "development" role ["orchestrator"] statement "At a completed meaningful feature batch resolve findings, confirm records and obtain the appropriate current canonical GREEN before closure/publication. Small edits remain inside that batch rather than triggering repeated full gates. An hourly commit-readiness check inspects whether a meaningful verified batch is ready; the clock does not force commits, tests, reviews or unsupported completion claims." command "blabla finish" }
flow "hourly-intent-review" { purpose "An external hourly review opens a real task whose inputs include mission, goals, systems and process; this declaration does not schedule or launch agents." }
step "inspect-intent" { flow "hourly-intent-review" role ["creative-director"] statement "Read current status, explain the relevant intent and inspect the actual .bla files against the live world, owner direction and next twelve hours of development." command "blabla status" }
step "propose-intent-changes" { flow "hourly-intent-review" role ["creative-director"] statement "Record dated concrete proposals, findings or questions with evidence, assess the design lens and hand the bounded review back without changing requirements to match a failing implementation." command "blabla task ready" }
step "decide-intent-changes" { flow "hourly-intent-review" role ["orchestrator"] statement "Accept or reject each proposal explicitly; scope approved intent edits as a separate task, preserve historical decisions and verify the updated project. Fun and balance observations inform the next feature rather than block launch." command "blabla task open" }

policy "astra-only-visual-work" { statement "All new development assignments in the current team use actual gpt-6-astra with xhigh effort. Visual, simulation, tooling and server roles retain primary responsibilities but may carry another bounded role through an explicit accepted BlaBla handoff. Historical work retains its true model and evidence; do not relabel it or rewrite it merely for staffing consistency." applies_to ["orchestrator", "worker", "creative-director", "visual-implementer", "art-director", "server-owner"] }
flow "director-event" { purpose "Released procedural events follow actual world facts, versioned weights and engine cooldowns; creative direction reviews their design at feature boundaries." }
step "read-and-consult" { flow "director-event" role ["orchestrator", "creative-director"] statement "At an explicit supported runtime wake the seeded procedural Director chooses only released legal events and targets using versioned weights, real world conditions and existing cooldowns. It commits through the same protected engine and durable receipt path. Creative direction authors and reviews the event vocabulary and tuning at feature boundaries, not by approving every runtime event. Routine events never advance years; a deliberate historical advance remains separately authorized and explained." }
policy "affected-intent-disposition" { statement "New feature and intent tasks opt into --require-intent-disposition. Before hand-back, inspect each affected mission, goal, system, process and knowledge identity and record a current updated or confirmed-unchanged reason with task disposition. Changed source or intent invalidates relevant receipts; independent review assesses their meaning. Legacy tasks retain their original obligations. Receipts enforce accountability, not semantic truth or goal acceptance." applies_to ["orchestrator", "reviewer", "creative-director", "worker", "visual-implementer", "art-director", "server-owner"] }
policy "research-before-features" { statement "Every feature has recorded proportional research and a chosen approach before implementation. Prefer actual current source, verified primary references and reusable prior findings. Research does not authorize new scope and must not become an indefinite gate that replaces delivery." applies_to ["orchestrator", "worker", "creative-director", "visual-implementer", "art-director", "server-owner"] }
policy "productive-role-lookahead" { statement "Maintain a prioritized dependency-aware queue with concrete ready successors. Use all available development slots when useful independent work exists; do not create busywork or overlapping writes. Roles have primary expertise but can accept cross-role bounded work through BlaBla. Nobody reviews their own patch; at meaningful feature boundaries a clean reviewer receives task, diff and evidence. Procedural civilizations act independently of developer task handoffs, so developers no longer spend their breaks playing runtime seats." applies_to ["orchestrator", "worker", "reviewer", "creative-director", "visual-implementer", "art-director", "server-owner"] }
policy "cohesive-intent-growth" { statement "A feature task decides whether to extend an existing cohesive contract or register a new system-scoped .bla file, linking it to its goals and affected systems. Inspect registration, missing references, orphan files and duplicated rules using actual available tools and source review. Unregistered files are not authority; mechanical inventories cannot prove semantic consistency. Reuse BlaBla identities, fingerprints and disposition receipts rather than creating a parallel review ledger." applies_to ["orchestrator", "worker", "reviewer", "creative-director", "visual-implementer", "art-director", "server-owner"] }

role "art-director" { purpose "Own only original art, visual language, spectator UI/CSS, effects, animation and reusable asset direction, distinct from gameplay and systems design." owns ["assigned art and spectator presentation", "reusable geometry materials and visual budgets", "actual desktop and mobile visual evidence"] verification "focused" model ["gpt-6-astra"] consult ["engineering", "testing", "design"] }
flow "observer-friction-review" { purpose "An external hourly observer check asks the orchestrator about actual workflow friction and corrective actions; this declaration is not a scheduler and never advances world time." }
step "inspect-friction" { flow "observer-friction-review" role ["orchestrator"] statement "Provide concrete blocker, misuse or tool-defect evidence and the bounded remedy. Distinguish product changes from environmental limits, preserve actual checks and keep the next feature moving." }

role "server-owner" { purpose "Own authoritative server and multiplayer correctness, synchronization, persistence, access control, migrations and durable clock realization using actual Astra." owns ["assigned server and multiplayer scope", "database and protocol integrity", "bounded read and write performance"] verification "focused" model ["gpt-6-astra"] consult ["engineering", "testing"] }
policy "astra-server-ownership" { statement "Authoritative runtime correctness has a primary Astra/xhigh server owner. Explicit accepted role handoffs may transfer a disjoint implementation or review scope while preserving source and evidence ownership. Historical model play remains honestly attributed; new procedural runtime control needs no developer civilization-seat ownership." applies_to ["orchestrator", "worker", "server-owner"] }

policy "clear-spectator-language" { statement "Review spectator copy for non-native English readers: familiar words, short direct sentences, no idioms or unnecessary jargon, consistent game terms with keyboard and tap explanations, and visible important numbers and changes. Preserve concrete mechanics and causes; do not replace facts with vague decorative prose. Semantic icons, color and emphasis reinforce text rather than replace meaning." applies_to ["orchestrator", "creative-director", "art-director", "visual-implementer", "reviewer"] }

policy "current-model-staffing" { statement "The current six development streams use actual Astra/xhigh: intent/integration, civilization behaviors, authoritative runtime, spectator interface, world presentation and BlaBla tooling. Record actual model and effort at acceptance. Primary specialties guide assignment, not idle silos: the orchestrator assigns a ready disjoint useful successor or a clean review handoff when a primary stream is waiting. Never infer or fabricate the model of an external coordinator." applies_to ["orchestrator", "worker", "creative-director", "art-director", "server-owner", "reviewer"] }


policy "affected-delivery-outcomes" { statement "For each affected delivered feature, explicitly select the relevant owner goals and user-visible outcomes at assignment. Creative Director reviews the actual player loop; Art Director reviews actual spectator pixels and comprehension for visual outcomes, or records unavailable evidence. Record source-verified and live-observed results separately. Partial or blocked applicable outcomes remain visible with an owner and concrete successor or unblock condition; bounded source closure, green tests and minor polish never silently satisfy a broader outcome. Reuse task dispositions, reflection and independent review rather than a global audit. The pending BlaBla delivery-obligation feature must enforce these records; this policy alone is not a claim that such enforcement already exists." applies_to ["orchestrator", "worker", "reviewer", "creative-director", "art-director", "server-owner"] }

policy "live-decision-followthrough" { statement "After an explicitly activated procedural feature, inspect real controller decisions across all five civilizations and the Director: useful required commitments, actual progress/completion and subsequent decisions, or a canonical blocked reason. Active commitments remain intact and plans revalidate. Record source, local-observatory and shared-host evidence separately. Overdue upkeep or an empty menu is not proof of structural inability, and missing scheduling is not proof of unattended play. No developer must act as a runtime civilization." applies_to ["orchestrator", "worker", "creative-director", "server-owner"] }

policy "feature-batch-verification-cadence" { statement "The owner requires tests and independent reviews after meaningful large features, not after small changes. Plan a cohesive feature with a decisive finite check; gather normal implementation changes, run and inspect that check at the boundary, independently review the batch, and run canonical integration gates before completion. Recover a concrete failed check or materially invalidated evidence with the narrow necessary rerun. Do not repeatedly run full suites for prose tweaks, metadata refresh, every worker handoff or an hourly timer. This cadence never waives a failing contract, current evidence, clean review or truthful unfinished status." applies_to ["orchestrator", "worker", "reviewer", "creative-director", "visual-implementer", "art-director", "server-owner"] }
policy "procedural-runtime-separation" { statement "The runtime uses seeded procedural generation and weighted finite-state controllers without LLM calls. Development agents remain real BlaBla workers, not mandatory civilization players. Preserve historical model-agent provenance. Explicitly label local simulation, shared-host observations, procedural decisions and contract probes; neither browser playback nor public reads mutate the shared world." applies_to ["orchestrator", "worker", "reviewer", "creative-director", "visual-implementer", "art-director", "server-owner"] }
policy "blabla-friction-to-product" { statement "Proactively inspect concrete dogfooding friction, failed or misleading guidance, redundant work and evidence costs. Record observed facts in existing task findings, distinguish environment limits from BlaBla defects, then assign the smallest useful bounded improvement with honest verification. Reuse supported freshness, receipt and evidence-reuse routes rather than bypassing gates or adding a parallel report ledger." applies_to ["orchestrator", "worker", "reviewer", "creative-director", "visual-implementer", "art-director", "server-owner"] }
