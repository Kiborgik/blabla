state accepted: bool
state exact_route_and_participants: bool
state exact_registered_target: bool
state consent_recorded: bool
state teaching_paid: bool
state study_count: int
state post_acceptance_deliveries: bool
state same_round_institutions: bool
state complete_opening_funding: bool
state exact_contributions: bool
state credits_conserved_except_one: bool
state bounded_remaining_work: bool
state once_only_grant: bool
state refused_unchanged: bool
state restart_exact: bool
state observer_matches_receipts: bool

action propose_knowledge()
action respond_knowledge()
action resolve_knowledge()
action restart_knowledge()
action inspect_knowledge()

when propose_knowledge {
    expect "proposal-binds-exact-existing-partnership-and-discovery": not after.accepted or after.exact_route_and_participants and after.exact_registered_target
    expect "proposal-does-not-pay-for-teaching": not after.teaching_paid
}
when respond_knowledge {
    expect "acceptance-is-consent-not-payment-or-study": not after.accepted or after.consent_recorded and not after.teaching_paid and after.study_count == 0
    expect "invalid-consent-has-no-effects": after.accepted or after.refused_unchanged
}
when resolve_knowledge {
    expect "teaching-requires-two-fresh-supported-studies": not after.teaching_paid or after.consent_recorded and after.study_count == 2 and after.post_acceptance_deliveries and after.same_round_institutions
    expect "teaching-is-fully-funded-and-conserved": not after.teaching_paid or after.complete_opening_funding and after.exact_contributions and after.credits_conserved_except_one
    expect "paid-assistance-is-bounded-and-once-only": not after.teaching_paid or after.bounded_remaining_work and after.once_only_grant
}
when restart_knowledge {
    expect "current-version-restart-retains-exact-commitments-and-grants": after.restart_exact
}
when inspect_knowledge {
    expect "observer-distinguishes-promises-studies-payment-and-discovery": after.observer_matches_receipts
}
