module app "app.py"

require "storage-class":      symbol app::TodoStorage
require "application-class":  symbol app::TodoApplication
require "actions-are-bound":  symbol app::bind
require "atomic-save":        symbol app::TodoStorage.save
require "the-transport-is-reused": dependency app -> "blabla_adapter"
forbid  "no-network":         dependency app -> "socket"
forbid  "no-subprocess":      dependency app -> "subprocess"
forbid  "no-protocol-loop-in-the-application": symbol app::serve
forbid  "no-wire-writer-in-the-application":   symbol app::emit
