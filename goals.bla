goal "workers-stop-instead-of-guessing" {
    serves ["bounded-workers-free-planners", "truthful-over-convenient"]
    statement "A worker's call below its role's floor stops the task until the orchestrator answers it."
    expect ["contract::decisions"]
    state "done"
}

goal "orchestrator-records-are-attested" {
    serves ["truthful-over-convenient"]
    statement "A record made under an orchestrator model while a worker carries the task stands until the orchestrator confirms it."
    expect ["contract::attestation"]
    state "done"
}

goal "the-orchestrator-asks-what-it-doubts" {
    serves ["steering-cost-over-token-cost", "bounded-workers-free-planners"]
    statement "A question the orchestrator asks gets the worker's pick with a stated confidence before the task can be handed back."
    expect ["contract::questions"]
    state "active"
}

goal "no-process-outlives-its-run" {
    serves ["truthful-over-convenient"]
    statement "A restarted or finished application leaves no descendant process behind."
    expect ["lifecycle::a-restart-leaves-no-descendant-behind", "lifecycle::a-finish-leaves-no-descendant-behind"]
    state "done"
}

goal "hand-backs-survive-concurrent-work" {
    serves ["bounded-workers-free-planners"]
    statement "A worker's hand-back holds while other tasks and the orchestrator change the tree around it."
    expect ["assignment::reconciling-concurrent-work-keeps-the-challenge-receipt", "assignment::a-closed-concurrent-task-still-accounts-for-its-change", "assignment::a-note-keeps-the-challenge-receipt"]
    state "done"
}

goal "bounded-expert-release-ready-for-review" {
    serves ["truthful-over-convenient", "steering-cost-over-token-cost", "bounded-workers-free-planners"]
    statement "Prepare the bounded 0.10 expert foundation for independent user review while preserving deterministic completion and stating unverified live delivery and benefit honestly. Contract expectations do not replace release checks or user acceptance."
    expect ["contract::expert", "contract::expert-seams", "contract::assignment", "contract::gate", "contract::schedule"]
    state "active"
}

goal "short-plain-docs" {
    serves ["disclosure-over-dumping", "steering-cost-over-token-cost"]
    statement "0.11 says one idea in plain English, far shorter than 0.10 (a target of up to ten times, never at the cost of facts or tables people need): small models drift and claim done too early, so a human or a strong model writes contracts once and cheap models do bounded work against them. The CLI, status and explain stay the detailed reference; history files are not shortened."
    expect ["contract::onboarding"]
    state "active"
}

goal "task-show-prints-evidence" {
    serves ["truthful-over-convenient", "disclosure-over-dumping"]
    statement "Backlog: the text view of blabla task show prints the latest declared-check result (exit code, log path, epoch) and the recorded lens assessments. Today a reviewer must read --json or run challenge to learn whether the check passed."
    expect ["workflow::task-show-prints-the-latest-evidence"]
    state "active"
}

goal "expert-commands-describe-themselves" {
    serves ["disclosure-over-dumping"]
    statement "Backlog: every blabla expert subcommand has a one-line description in --help. Today all twelve print an empty description."
    expect ["onboarding::expert-commands-describe-themselves"]
    state "active"
}

goal "docs-links-are-checked" {
    serves ["truthful-over-convenient"]
    statement "Backlog: the product gate fails when a relative link or anchor in a tracked markdown file does not resolve. 0.11 shortened and merged many docs and checked links by hand once; nothing keeps them true."
    expect ["schedule::docs-links-resolve"]
    state "active"
}

goal "self-carried-tasks-skip-self-confirmation" {
    serves ["steering-cost-over-token-cost"]
    statement "A task assigned to role::orchestrator records its own scope or check amendments without an orchestrator-record-during-carry challenge, so the orchestrator never confirms its own records. Tasks carried by any other role keep the challenge and the confirmation. The owner approved this in the 0.11 dogfooding round."
    expect ["attestation::the-orchestrator-carrying-its-own-task-needs-no-confirmation", "attestation::an-orchestrator-record-made-while-a-worker-carries-the-task-is-listed"]
    state "active"
}

goal "tasks-name-their-lenses" {
    serves ["steering-cost-over-token-cost", "bounded-workers-free-planners"]
    statement "task open --lens PACK names the subset of the role's consulted packs a task must assess, as ruling::design::lens-applicability-follows-responsibility already expects; without it every consulted pack is required, as today. A pack the role does not consult is refused."
    expect ["lenses::a-task-can-name-its-lenses"]
    state "active"
}

goal "tests-prove-their-change" {
    serves ["truthful-over-convenient", "bounded-workers-free-planners"]
    statement "A task can name the production paths its change touches with task open --falsify; BlaBla then runs the declared check against the opened contents of those paths and refuses hand-back unless the check failed there and passes now. Small-model workers wrote three tests this round that passed without the code they claimed to prove; this makes that visible without a reviewer reading the old code."
    expect ["falsify::a-task-can-name-the-paths-its-check-must-falsify", "falsify::the-check-is-run-against-the-opened-contents", "falsify::an-unfalsified-check-is-challenged"]
    state "active"
}

goal "versions-agree" {
    serves ["truthful-over-convenient"]
    statement "The product gate fails when the version in Cargo.toml differs from the one in .claude-plugin/plugin.json, CITATION.cff or the issue template placeholders. The version is one decision stored in several files."
    expect ["schedule::versions-agree"]
    state "active"
}

goal "expert-loop-demonstrated-in-real-work" {
    serves ["truthful-over-convenient", "steering-cost-over-token-cost", "bounded-workers-free-planners"]
    statement "Complete the original 0.10 workflow: a shipped named host adapter observes real work boundaries, evaluates bounded expert judgments, delivers authorized advice to the same worker and records acknowledgment separately from observed correction. Exercise actual feature work and matched off/shadow/advisory runs. Publish concise human/agent documentation and accurate diagrams. Contract expectations are necessary checks, not proof of live delivery, benefit or user acceptance."
    expect ["contract::expert", "contract::expert-seams", "contract::assignment", "contract::gate", "contract::schedule"]
    state "active"
}
