module model "widget/model.py"
module store "widget/store.py"
module format "widget/format.py"
module ids "widget/ids.py"
module log "widget/log.py"
module app "app.py"

require "a-widget-is-a-type":            symbol model::Widget
require "the-model-names-its-fields":    symbol model::FIELDS
require "the-store-is-a-type":           symbol store::WidgetStore
require "state-is-read-back-at-start":   symbol store::WidgetStore.load
require "state-survives-a-restart":      symbol store::WidgetStore.save
require "the-application-is-bound":      symbol app::WidgetApplication
require "actions-are-bound":             symbol app::bind
require "the-store-uses-the-model":      dependency store -> model
require "the-app-uses-the-adapter":      dependency app -> "blabla_adapter"

require "the-format-encodes":                   symbol format::encode
require "the-format-decodes":                   symbol format::decode
require "ids-are-minted-in-one-place":          symbol ids::next_id
require "diagnostics-have-one-owner":           symbol log::note
require "the-app-mints-ids-through-ids":        dependency app -> ids
require "the-store-encodes-through-the-format": dependency store -> format

forbid "the-model-stays-below-the-store":       dependency model -> store
forbid "the-format-stays-below-the-store":      dependency format -> store
forbid "the-store-encodes-nothing-itself":      dependency store -> "json"
