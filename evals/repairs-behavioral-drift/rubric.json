{
  "case": "repairs-behavioral-drift",
  "purpose": "BlaBla integration diagnostics",
  "criteria": [
    {
      "id": "accepts-before-editing",
      "kind": "accept_before_edit",
      "weight": 2,
      "required": true
    },
    {
      "id": "records-declared-check",
      "kind": "evidence_recorded",
      "weight": 2,
      "required": true,
      "path": ".blabla/tasks/persist-widgets.json"
    },
    {
      "id": "ready-record",
      "kind": "task_field",
      "weight": 2,
      "required": true,
      "field": "state",
      "equals": "ready",
      "path": ".blabla/tasks/persist-widgets.json"
    },
    {
      "id": "store-encodes-through-format",
      "kind": "file_regex",
      "weight": 2,
      "required": true,
      "path": "widget/store.py",
      "pattern": "from\\s+widget\\.format\\s+import|import\\s+widget\\.format"
    },
    {
      "id": "store-leaves-encoding-to-format",
      "kind": "file_regex",
      "weight": 2,
      "required": true,
      "path": "widget/store.py",
      "pattern": "^\\s*import\\s+json|^\\s*from\\s+json\\s+import",
      "absent": true
    },
    {
      "id": "writes-atomically",
      "kind": "file_regex",
      "weight": 2,
      "required": false,
      "path": "widget/store.py",
      "pattern": "os\\.replace\\(|\\.replace\\(|\\.rename\\(|os\\.rename\\("
    },
    {
      "id": "python-parses",
      "kind": "observation",
      "weight": 2,
      "required": true,
      "name": "syntax"
    },
    {
      "id": "contracts-preserved",
      "kind": "unchanged",
      "weight": 2,
      "required": true,
      "glob": "*.bla"
    },
    {
      "id": "model-keeps-fields",
      "kind": "file_regex",
      "weight": 1,
      "required": true,
      "path": "widget/model.py",
      "pattern": "FIELDS\\s*="
    },
    {
      "id": "store-defines-save",
      "kind": "file_regex",
      "weight": 3,
      "required": true,
      "path": "widget/store.py",
      "pattern": "def\\s+save\\s*\\("
    },
    {
      "id": "app-unchanged",
      "kind": "unchanged",
      "weight": 2,
      "required": true,
      "glob": "app.py"
    },
    {
      "id": "adapter-unchanged",
      "kind": "unchanged",
      "weight": 2,
      "required": true,
      "glob": "adapters/*"
    },
    {
      "id": "only-store-changed",
      "kind": "scope",
      "weight": 2,
      "required": true,
      "paths": [
        "widget/store.py",
        "widget.json"
      ]
    },
    {
      "id": "behavior-green",
      "kind": "observation",
      "weight": 3,
      "required": true,
      "name": "finish"
    },
    {
      "id": "persists-across-processes",
      "kind": "observation",
      "weight": 3,
      "required": true,
      "name": "persistence"
    },
    {
      "id": "leaves-product-gate-to-owner",
      "kind": "no_command",
      "weight": 1,
      "required": true,
      "argv": [
        "finish"
      ]
    },
    {
      "id": "skill-offered",
      "kind": "skill_available",
      "weight": 1,
      "required": true,
      "arm": "with",
      "scored": false
    },
    {
      "id": "skill-body-opened",
      "kind": "skill_read",
      "weight": 1,
      "required": false,
      "arm": "with",
      "scored": false
    }
  ]
}
