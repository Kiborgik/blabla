project GlyphVaultDurableId

use structure "../../../../examples/glyph-vault/contracts/structure/architecture.bla"

use behavior "../../../../examples/glyph-vault/contracts/behavior/core.bla"
use behavior "../../../../examples/glyph-vault/contracts/behavior/persistence.bla"
use behavior "../../../../examples/glyph-vault/contracts/behavior/sealing.bla"
use behavior "../../../../examples/glyph-vault/contracts/behavior/quarantine.bla"
use behavior "../../../../examples/glyph-vault/contracts/behavior/resonance.bla"
