project blabla

mission "mission.bla"
system "system.bla"
process "process.bla"

knowledge "knowledge/engineering.bla"
knowledge "knowledge/testing.bla"
knowledge "knowledge/reviewing.bla"
knowledge "knowledge/design.bla"

use structure "contracts/extractor.bla"
use structure "contracts/publication.bla"
use structure "contracts/secrets.bla"
use structure "contracts/gate.bla"
use structure "contracts/schedule.bla"
use structure "contracts/diagrams.bla"
use structure "contracts/rust.bla"
use structure "contracts/providers.bla"
use structure "contracts/workflow.bla"
use structure "contracts/onboarding.bla"

use behavior "contracts/evaluator.bla"
use behavior "contracts/assignment.bla"
use behavior "contracts/voice.bla"

ignore from ".gitignore"

verify behavior {
    command ["target/debug/examples/structure-adapter"]
    seed 0
    cases 32
    steps 256
    timeout_ms 5000
    shrink_budget 256
}
