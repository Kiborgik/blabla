module auditor "experiments/audit_public_tree.py"

require "has-windows-path":      value auditor::PATTERNS contains "windows-drive-path"
require "has-user-profile":      value auditor::PATTERNS contains "user-profile"
require "has-owner-handle":      value auditor::PATTERNS contains "owner-handle"
require "has-anthropic-key":     value auditor::PATTERNS contains "anthropic-key"
require "has-openai-style-key":  value auditor::PATTERNS contains "openai-style-key"
require "has-github-token":      value auditor::PATTERNS contains "github-token"
require "has-aws-access-key":    value auditor::PATTERNS contains "aws-access-key"
require "has-private-key":       value auditor::PATTERNS contains "private-key"
require "has-api-key-assign":    value auditor::PATTERNS contains "api-key-assignment"
require "has-session-id":        value auditor::PATTERNS contains "session-id"

require "allow-license":         value auditor::ALLOWED maps "LICENSE" to "owner-handle"
require "allow-citation":        value auditor::ALLOWED maps "CITATION.cff" to "owner-handle"
require "allow-auditor":         value auditor::ALLOWED maps "experiments/audit_public_tree.py" to "owner-handle"
