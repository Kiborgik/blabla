module gate "experiments/gate.py"

require "run-command-executor": symbol gate::run
require "gates-orchestrator": symbol gate::checks
require "test-validation": symbol gate::rust_tests_are_clean
require "steps-run-in-a-required-order": symbol gate::REQUIRED_ORDER
require "main-entry": symbol gate::main

require "gate-checks-defined": symbol gate::STEPS

require "subprocess-module": dependency gate -> "subprocess"
require "json-module": dependency gate -> "json"

require "fmt-gate-checks-formatting": value gate::STEPS maps "fmt" to "fmt"
require "clippy-gate-runs-clippy":    value gate::STEPS maps "clippy" to "clippy"
require "clippy-gate-denies-warnings": value gate::STEPS maps "clippy" to "warnings"
require "rust-tests-gate-runs-tests": value gate::STEPS maps "rust-tests" to "nextest"
require "bridge-gate-builds":         value gate::STEPS maps "bridge" to "build"
require "self-hosting-gate-finishes": value gate::STEPS maps "self-hosting-finish" to "finish"
