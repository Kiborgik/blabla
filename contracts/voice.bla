type Voiced {
    class: string
}

state voice: string
state voiced_standing: [Voiced]
state voiced_keeps_the_statement: bool
state voiced_speaks_bluntly: bool
state voiced_adds_wording: bool

action select_the_neutral_voice()
action select_the_blunt_voice()

when select_the_blunt_voice {
    expect "the-blunt-voice-is-what-was-selected":
        after.voice == "blunt"
    expect "blunt-adds-wording-only-where-a-contradiction-stands":
        count(after.voiced_standing) == 0 or after.voiced_adds_wording
}

when select_the_neutral_voice {
    expect "the-neutral-voice-is-what-was-selected":
        after.voice == "neutral"
    expect "the-neutral-voice-adds-nothing":
        not after.voiced_adds_wording
}

always "a-rendering-never-drops-the-statement-it-renders" {
    voiced_keeps_the_statement
}

never "the-neutral-voice-ever-speaks-bluntly" {
    voice == "neutral" and voiced_speaks_bluntly
}
